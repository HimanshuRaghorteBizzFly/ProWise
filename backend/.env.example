# Copy to backend/.env for local runs (loaded automatically; backend/.env is git-ignored).
# PLACEHOLDERS ONLY. Never put a real password, key or App Password in this file: it is committed.
# Real environments set these as environment variables or via a secret manager.
# Development login accounts (Super Admin, Operator, Developer) are created only in the dev profile:
#   ./mvnw spring-boot:run -Dspring-boot.run.profiles=dev
DB_URL=jdbc:postgresql://localhost:5432/prowise
DB_USERNAME=prowise
DB_PASSWORD=prowise-dev-password
OUTBOX_POLL_DELAY_MS=5000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Generate: openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-a-random-32-byte-development-key
JWT_ISSUER=prowise

# Outgoing email (fallback until the Super Admin saves settings on the SMTP Email page).
# Gmail: SMTP_PASSWORD must be a 16-character App Password (Google Account > Security > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=dummy-app-password
SMTP_FROM=you@example.com
# Optional: SMTP_FROM_NAME=ProWise Platform, SMTP_REPLY_TO=, SMTP_ENCRYPTION=TLS|SSL|NONE
# Encrypts an SMTP password saved from the admin panel (AES-256-GCM). 32+ characters. Generate: openssl rand -base64 48
SMTP_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-random-key-of-at-least-32-characters

FRONTEND_URL=http://localhost:3000
# Auth cookies HTTPS-only. false for plain-HTTP local development; production defaults to true.
AUTH_SECURE_COOKIES=false
# Optional: first Super Admin. When set and no legitimate Super Admin exists, startup creates one pending
# account and emails it a single-use 72-hour setup link. Requires working SMTP. Remove once activated.
# PROWISE_BOOTSTRAP_SUPER_ADMIN_EMAIL=first.admin@your-company.example
# Optional: initial password for that account instead of the email link. The account starts ACTIVE and must
# choose a new password at first sign-in. 12+ chars with upper, lower, number and symbol. Never resets an
# active Super Admin. Remove once you have signed in.
# PROWISE_BOOTSTRAP_SUPER_ADMIN_PASSWORD=Change-Me-At-First-Login-1

# Optional: database backups from the operator console (POST /v1/operator/backups). Both unset = backups are
# reported as NOT_CONFIGURED (503). The directory receives prowise-<UTC timestamp>-<id>.dump files (pg_dump
# custom format, restore with pg_restore). The password from DB_PASSWORD is passed to pg_dump only through
# PGPASSWORD in the child process environment, never on the command line or in logs.
# PROWISE_BACKUP_DIR=
# Full path to pg_dump (or leave empty to use pg_dump from PATH). Use the same major version as the server.
# PROWISE_PG_DUMP_PATH=
# Optional: a run is stopped and marked FAILED after this many minutes (default 60).
# PROWISE_BACKUP_TIMEOUT_MINUTES=60
