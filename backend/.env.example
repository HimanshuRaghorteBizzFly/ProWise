# Copy to backend/.env for local runs (loaded automatically). Dummy values only;
# real environments set these as environment variables or via a secret manager.
# Development login accounts (Super Admin, Operator, Developer) are created only in the dev profile:
#   ./mvnw spring-boot:run -Dspring-boot.run.profiles=dev
DB_URL=jdbc:postgresql://localhost:5432/prowise
DB_USERNAME=prowise
DB_PASSWORD=prowise-dev-password
OUTBOX_POLL_DELAY_MS=5000
CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_SIGNING_KEY=replace-with-a-random-32-byte-development-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=dummy-notifications@gmail.com
SMTP_PASSWORD=dummy-app-password
SMTP_FROM=no-reply@prowise.com
FRONTEND_URL=http://localhost:3000
# Sessions: access token (JWT, sent as Authorization: Bearer) and refresh session (opaque, httpOnly cookie only).
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=7
# false = the 7 days are counted from sign-in (absolute); true = every refresh restarts the 7 days.
REFRESH_SLIDING=false
# Two tabs refreshing with the same cookie within this many seconds are not treated as a stolen token.
REFRESH_REUSE_GRACE_SECONDS=10
# Secure refresh cookie: true in production (HTTPS); the dev profile defaults to false for http://localhost.
AUTH_COOKIE_SECURE=false
# Browser-facing path of the auth endpoints (the frontend proxies /api/v1/* to the backend).
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
