      "signature": "sha256=4e4fed11799277976e75a22884cdcb4446561e5ac92e3380c0d6e92888f363f1",
      "expectValid": true,
      "note": "valid signed pull_request"
    },
    {
      "name": "push.main",
      "deliveryId": "7d0a6b1e-0000-4000-8000-000000000002",
      "event": "push",
      "payloadFile": "push.main.json",
      "signature": "sha256=55fa78974544a38451705e81fd3f7563b75d4802388df9b5dbce6de2a8bd67dd",
      "expectValid": true,
      "note": "valid signed push"
    },
    {
      "name": "pull_request.tampered",
      "deliveryId": "7d0a6b1e-0000-4000-8000-000000000003",
      "event": "pull_request",
      "payloadFile": "pull_request.tampered.json",
      "signature": "sha256=4e4fed11799277976e75a22884cdcb4446561e5ac92e3380c0d6e92888f363f1",
      "expectValid": false,
      "note": "body changed after signing; must be rejected"
    },
    {
      "name": "push.main.duplicate",
