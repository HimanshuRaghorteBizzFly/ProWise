      "payloadFile": "push.main.json",
      "signature": "sha256=55fa78974544a38451705e81fd3f7563b75d4802388df9b5dbce6de2a8bd67dd",
      "expectValid": true,
      "note": "same X-GitHub-Delivery redelivered; consumer must dedupe"
    }
  ]
}
